# Токен от @BotFather. Никогда не коммить настоящий токен.
BOT_TOKEN=

# Юзернейм бота без @. Ссылка рефералки: t.me/<BOT_USERNAME>?startapp=ref_<id>
BOT_USERNAME=TapTeddy_bot

# HTTPS-адрес мини-приложения. Локально можно оставить http, в Telegram нужен https.
WEBAPP_URL=http://localhost:5173

# Канал, где публикуется утренний код (необязательно). Пример: https://t.me/tapteddy
CHANNEL_URL=

PORT=3000

# Путь относительно корня репозитория, либо абсолютный.
DATABASE_PATH=./data/tapteddy.sqlite

# Секрет подписи сессий. Сгенерируй: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 1 — вход без Telegram и тестовые покупки без звёзд. На бою ОБЯЗАТЕЛЬНО 0.
DEV_MODE=1

# Telegram id владельца через запятую. /dailycode и /refund только им.
# Свой id бот присылает в ответ на /start.
ADMIN_IDS=

# Куда слать игроков по оплате. Без @. Если пусто, бот просто просит написать в чат.
SUPPORT_USERNAME=

# Соль утреннего кода. Если пусто, при первом запуске случайная соль пишется в SQLite.
DAILY_CODE_SALT=
